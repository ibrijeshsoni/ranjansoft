version: "3.9"

services:
  ranjansoft:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: ranjansoft-web
    restart: unless-stopped
    ports:
      - "10105:80"
      - "10443:443"
    volumes:
      # Mount real SSL certs (Let's Encrypt or self-signed)
      # Place your certs in ./certs/ on the host:
      #   ./certs/fullchain.pem
      #   ./certs/privkey.pem
      - ./certs:/etc/nginx/certs:ro
