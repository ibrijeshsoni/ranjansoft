# Copy to .env and fill in. .env is git-ignored; never commit real values.

# MongoDB on the stock-market server, reached over Tailscale.
DB_HOST=stock-market-server.beetal-sun.ts.net
DB_PORT=27017
DB_NAME=ranjansoft
# Leave empty while the server has no auth; set both once it does.
DB_USER=
DB_PASSWORD=

# SMTP for the "new enquiry" email. For Gmail, turn on 2-step verification
# and create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hr.ranjansoft@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="RanjanSoft Website <hr.ranjansoft@gmail.com>"
MAIL_TO=hr.ranjansoft@gmail.com

# Sites on another origin that may post to the API, comma-separated.
# Needed when the page is on GitHub Pages and the API runs on your own server.
ALLOWED_ORIGINS=https://ranjansoft.github.io,https://ibrijeshsoni.github.io
